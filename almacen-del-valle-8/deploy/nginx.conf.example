# Alternativa a Caddy: nginx con certificado de Let's Encrypt (certbot).
#
#   sudo certbot --nginx -d tudominio.com.ar
#
# certbot completa las rutas del certificado y renueva automáticamente.
# Copiá este archivo a /etc/nginx/sites-available/almacen y reemplazá "tudominio.com.ar".

server {
    listen 80;
    server_name tudominio.com.ar;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name tudominio.com.ar;

    # certbot agrega acá ssl_certificate y ssl_certificate_key

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
