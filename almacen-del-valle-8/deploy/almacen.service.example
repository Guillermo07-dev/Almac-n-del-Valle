# Servicio de systemd para que la tienda arranque sola con el servidor.
# Copiar a /etc/systemd/system/almacen.service y ejecutar:
#   sudo systemctl enable --now almacen

[Unit]
Description=Almacen del Valle
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/almacen-del-valle
Environment=USE_HTTPS=1
Environment=SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
Environment=SITE_URL=https://tudominio.com.ar
Environment=ADMIN_PASSWORD=cambiar-por-una-contraseña-segura
ExecStart=/opt/almacen-del-valle/venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8000 wsgi:app
Restart=always

[Install]
WantedBy=multi-user.target
